# Copy to .env (git ignores it) and fill in. Read by docker-compose.yml, and by the app when you export it yourself.
# Everything is optional: with nothing set, the app is the demo on one computer (SQLite, password login).

# ---- Log in with a GitHub App (docs/HOSTING.md, "The GitHub App")
# From the App's settings page: "Client ID", and a client secret you generate there.
EVIDENCE_LAB_GITHUB_CLIENT_ID=
EVIDENCE_LAB_GITHUB_CLIENT_SECRET=
# The App's name in its URL (github.com/apps/<slug>), for the "install the app" link. Optional.
EVIDENCE_LAB_GITHUB_APP_SLUG=
# Who may log in (at least one is required when the GitHub login is set up; everyone shares the same assessments).
# Users: GitHub logins or numeric account ids, comma-separated. Orgs: active members of these organizations
# (give the App the organization permission "Members: read-only" and install it there).
EVIDENCE_LAB_GITHUB_ALLOWED_USERS=
EVIDENCE_LAB_GITHUB_ALLOWED_ORGS=
# on: every GitHub account may log in.
EVIDENCE_LAB_GITHUB_ALLOW_ANYONE=off
# The password login. Default: off when the GitHub login is set up, on otherwise.
# EVIDENCE_LAB_PASSWORD_LOGIN=off

# ---- The address people open. The GitHub App's callback URL is this + /api/auth/github/callback.
# With https:// the login cookies are marked Secure.
EVIDENCE_LAB_PUBLIC_URL=http://localhost:8000
# Other host names the app answers to (behind a load balancer, for example), comma-separated.
EVIDENCE_LAB_ALLOWED_HOSTS=

# ---- Database, cache, files. docker-compose.yml sets these to its own PostgreSQL, Redis and SeaweedFS (S3).
# EVIDENCE_LAB_DATABASE_URL=postgresql://user:password@host:5432/evidence_lab
# EVIDENCE_LAB_REDIS_URL=redis://host:6379/0
# EVIDENCE_LAB_STORAGE_URL=s3://bucket/prefix        (AWS credentials from the usual AWS variables or role)
# EVIDENCE_LAB_S3_ENDPOINT_URL=http://s3:8333        (any S3-compatible server; GCS: https://storage.googleapis.com with HMAC keys)
# EVIDENCE_LAB_STORAGE_URL=gs://bucket/prefix        (Google Cloud Storage with the host's Google credentials)

# ---- Passwords of the local stack in docker-compose.yml (change them for anything but your own computer)
POSTGRES_PASSWORD=evidence-lab-local
S3_ACCESS_KEY=evidence-lab
S3_SECRET_KEY=evidence-lab-local
S3_BUCKET=evidence-lab

# ---- Live Otto (unchanged; see README)
# ANTHROPIC_API_KEY=
