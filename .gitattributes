# Git LFS (large-file storage), from phase 4c+ on: every NEW file under docs/screenshots/ and demo/vectors/
# is stored in LFS, so the repository stops growing with each phase's pictures and test sets.
docs/screenshots/** filter=lfs diff=lfs merge=lfs -text
demo/vectors/** filter=lfs diff=lfs merge=lfs -text
demo/vectors/**/*.md !filter !diff !merge
# The files that were already in the repository on 15 November 2026 stay ordinary files, so no history is
# rewritten and a copy made without Git LFS still has every picture and every pinned test-set file.
